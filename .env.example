# ============================================================================
# Autonomous Multi-Agent Product Strategy Simulator
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# GOOGLE GEMINI API (Free tier available - required for ADK agents)
# ============================================================================
# Obtain from: https://aistudio.google.com/app/apikeys
# Multiple keys can be comma-separated for load balancing and rate limit management
GEMINI_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# Enable Google ADK agents for live LLM-powered simulations
# Set to 'false' to use deterministic fallback logic
ENABLE_ADK_AGENTS=true

# ADK model to use (options: gemini-2.0-flash, gemini-1.5-pro, etc.)
ADK_MODEL=gemini-2.0-flash

# ============================================================================
# GROK API (Optional - for real-time market analysis with X/Twitter data)
# ============================================================================
# Obtain from: https://console.x.ai/
# If not provided, market analysis falls back to free sources (RSS, Reddit, Wikipedia)
GROK_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-3-latest

# ============================================================================
# CLAUDE / ANTHROPIC API (Optional - for direct Claude integration)
# ============================================================================
# Obtain from: https://console.anthropic.com/
# Currently integrated through Google ADK, but can be added for direct usage
# CLAUDE_API_KEY=your_anthropic_key_here

# ============================================================================
# SIMULATION SETTINGS
# ============================================================================
# Default number of simulation steps per run (1-120)
DEFAULT_SIM_STEPS=5

# Agent timeout in seconds (prevents hanging on slow API responses)
AGENT_TIMEOUT_SECONDS=12

# Enable verbose logging for debugging (true/false)
VERBOSE_LOGGING=false

# ============================================================================
# MARKET DATA SOURCES (Optional - for free market intelligence)
# ============================================================================
# Enable/disable specific market data sources (true/false)
USE_GOOGLE_NEWS=true
USE_REDDIT=true
USE_WIKIPEDIA=true
USE_GOOGLE_TRENDS=true

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# API base URL for frontend to reach backend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Frontend port (Vite dev server)
VITE_PORT=5173

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================
# Log level (options: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable request/response logging for API calls
LOG_API_CALLS=false

# ============================================================================
# SECURITY & RATE LIMITING
# ============================================================================
# Maximum requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# Enable CORS for specific origins (comma-separated, or * for development)
CORS_ORIGINS=*

# ============================================================================
# DATABASE (Future use - for historical data persistence)
# ============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/simulator
# REDIS_URL=redis://localhost:6379

# ============================================================================
# DEPLOYMENT
# ============================================================================
# Environment type (development/staging/production)
ENVIRONMENT=development

# Backend host and port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ============================================================================
# NOTES
# ============================================================================
# 1. All API keys should be kept private and never committed to version control
# 2. The simulator gracefully degrades if optional APIs are unavailable
# 3. Free market sources (RSS, Reddit, Wikipedia) work without API keys
# 4. Multiple Gemini keys can improve rate limiting and redundancy
# 5. For production deployment, use a .env file managed by your DevOps team
# 6. See README.md for more information about each configuration option
